# Variáveis do bot — cadastre na Vercel (Settings → Environment Variables).
# Nunca coloque valores reais neste arquivo nem no front do CRM.

# Meta / Instagram
IG_VERIFY_TOKEN=uma-senha-que-voce-inventa
IG_APP_SECRET=
IG_ACCESS_TOKEN=
IG_GRAPH_VERSION=v26.0

# Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# Supabase (mesmo projeto do CRM). A service_role fica SÓ no servidor.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Opcionais
HANDOFF_WEBHOOK_URL=
PEREGRINOS_SITE_URL=
